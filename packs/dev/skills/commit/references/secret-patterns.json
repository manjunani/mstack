{
  "source": "Token shapes written from memory of the vendors' public documentation; not re-read during this work.",
  "checked": "2026-11-22",
  "verified": false,
  "patterns": [
    { "name": "aws-access-key-id", "regex": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b" },
    { "name": "github-token", "regex": "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b" },
    { "name": "github-fine-grained-token", "regex": "\\bgithub_pat_[A-Za-z0-9_]{40,}\\b" },
    { "name": "slack-token", "regex": "\\bxox[baprs]-[A-Za-z0-9-]{10,}" },
    { "name": "stripe-live-key", "regex": "\\b[sr]k_live_[A-Za-z0-9]{20,}\\b" },
    { "name": "google-api-key", "regex": "\\bAIza[0-9A-Za-z_\\-]{35}\\b" },
    { "name": "anthropic-api-key", "regex": "\\bsk-ant-[A-Za-z0-9_\\-]{20,}" },
    { "name": "openai-style-key", "regex": "\\bsk-(?:proj-)?[A-Za-z0-9_\\-]{40,}" },
    { "name": "private-key-block", "regex": "-----BEGIN (?:[A-Z]+ )?PRIVATE KEY(?: BLOCK)?-----" },
    { "name": "json-web-token", "regex": "\\beyJ[A-Za-z0-9_\\-]{10,}\\.eyJ[A-Za-z0-9_\\-]{10,}\\.[A-Za-z0-9_\\-]{10,}" },
    { "name": "password-in-url", "regex": "[a-z][a-z0-9+.\\-]*://[^/\\s:@'\"]+:([^/\\s:@'\"]{4,})@", "value_group": 1, "placeholders": true },
    { "name": "secret-assignment", "regex": "(?i)\\b(?:password|passwd|pwd|secret|token|api[_-]?key|apikey|access[_-]?key|auth[_-]?token|client[_-]?secret|private[_-]?key)\\b[\"']?\\s*[:=]\\s*[\"']([^\"'\\s]{8,})[\"']", "value_group": 1, "placeholders": true }
  ],
  "placeholder_words": ["example", "changeme", "change-me", "change_me", "your", "xxxx", "placeholder", "dummy", "sample", "redacted", "todo", "<", ">", "${", "{{", "%(", "****", "...", "process.env", "os.environ", "getenv"],
  "file_names": [".env", ".env.*", "*.pem", "*.key", "id_rsa", "id_dsa", "id_ecdsa", "id_ed25519", "*.p12", "*.pfx", "*.keystore", "*.jks", "credentials.json", "secrets.yml", "secrets.yaml", "secrets.json", ".npmrc", ".pypirc", ".netrc"],
  "file_names_allowed": [".env.example", ".env.sample", ".env.template", ".env.dist"]
}
